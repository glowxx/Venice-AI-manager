<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VeniceLauncher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/venice_accent_blue</item>
        <item name="colorPrimaryVariant">@color/venice_accent_light</item>
        <item name="colorOnPrimary">@color/venice_stucco_light</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/venice_stucco_mid</item>
        <item name="colorSecondaryVariant">@color/venice_stucco_mid</item>
        <item name="colorOnSecondary">@color/venice_deep_sea</item>
        
        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/venice_deep_sea</item>
        <item name="android:colorBackground">@color/venice_deep_sea</item>
        <item name="colorSurface">@color/venice_midnight_blue</item>
        <item name="colorOnSurface">@color/venice_stucco_light</item>
        
        <!-- System bars -->
        <item name="android:statusBarColor">@color/venice_deep_sea</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/venice_deep_sea</item>

        <!-- Material dialog styling -->
        <item name="materialAlertDialogTheme">@style/VeniceDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/VeniceBottomSheetDialogTheme</item>
    </style>

    <style name="VeniceBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/VeniceBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/venice_deep_sea</item>
    </style>

    <style name="VeniceBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="VeniceDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/venice_surface_dark</item>
        <item name="colorOnSurface">@color/venice_stucco_light</item>
        <item name="buttonBarPositiveButtonStyle">@style/VeniceDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/VeniceDialogButtonNegative</item>
    </style>

    <style name="VeniceDialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/venice_accent_light</item>
    </style>

    <style name="VeniceDialogButtonNegative" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/venice_muted</item>
    </style>

    <!-- Venice MaterialSwitch style -->
    <style name="VeniceSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track_selector</item>
        <item name="thumbTint">@color/switch_thumb_selector</item>
    </style>
</resources>
