<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/accounts_manager"
        android:textColor="@color/venice_stucco_light"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/accounts_manager_desc"
        android:textColor="@color/venice_muted"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_accounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxHeight="320dp"
        android:overScrollMode="never" />

    <!-- Action Buttons: Add Account and Incognito Mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_add_account"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="6dp"
            android:drawableTint="@color/venice_stucco_light"
            android:gravity="center"
            android:text="@string/add_account"
            android:textAllCaps="false"
            android:textColor="@color/venice_stucco_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_add_incognito"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_incognito"
            android:drawablePadding="6dp"
            android:drawableTint="@color/venice_stucco_mid"
            android:gravity="center"
            android:text="@string/btn_add_incognito"
            android:textAllCaps="false"
            android:textColor="@color/venice_stucco_mid"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
