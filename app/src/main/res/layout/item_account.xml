<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/account_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_inset_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <!-- Active Indicator / Check -->
    <ImageView
        android:id="@+id/iv_account_active"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Active"
        android:src="@drawable/ic_check"
        android:visibility="visible"
        app:tint="@color/venice_signal" />

    <!-- Account Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Account 1"
            android:textColor="@color/venice_stucco_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_account_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active session"
            android:textColor="@color/venice_signal"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Delete Account Button -->
    <ImageButton
        android:id="@+id/btn_delete_account"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_account"
        android:padding="6dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/venice_muted" />

</LinearLayout>
